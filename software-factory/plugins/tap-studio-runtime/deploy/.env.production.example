# A public DNS name pointing to your authorized Linux host. No actual domain is configured.
TAP_STUDIO_DOMAIN=studio.example.com
TAP_STUDIO_ADMIN_USER=admin
# Absolute path on the host; owner UID 10001 and restrictive file permissions.
TAP_STUDIO_SECRET_FILE=/path/to/private/tap-studio-admin-secret
TAP_STUDIO_IMAGE_TAG=0.2.0
